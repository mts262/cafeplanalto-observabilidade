{
  "uid": "cafe-planalto",
  "title": "Cafe Planalto - Observabilidade",
  "tags": ["cafe-planalto", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requisicoes por segundo",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (rota) (rate(http_requests_total[5m]))",
          "legendFormat": "{{rota}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 da API",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Sondas HTTP da filial",
      "type": "stat",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "probe_success",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pedidos criados por segundo",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(pedidos_criados_total[5m])",
          "legendFormat": "Pedidos/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Logs dos containers",
      "type": "logs",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 9},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "{job=\"docker\"}"
        }
      ]
    }
  ]
}
